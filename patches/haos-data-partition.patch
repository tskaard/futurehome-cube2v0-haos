diff --git i/buildroot-external/package/hassio/create-data-partition.sh w/buildroot-external/package/hassio/create-data-partition.sh
index 14a6504..8ab1adc 100755
--- i/buildroot-external/package/hassio/create-data-partition.sh
+++ w/buildroot-external/package/hassio/create-data-partition.sh
@@ -5,6 +5,7 @@ build_dir=$1
 dst_dir=$2
 channel=$3
 docker_version=$4
+board=$5
 
 data_img="${dst_dir}/data.ext4"
 data_dir="${build_dir}/data"
@@ -57,8 +58,26 @@ docker rm -f "${container}" > /dev/null
 sudo umount "${data_dir}"
 trap - ERR EXIT
 
-# Shrink the filesystem to its minimum size
-e2fsck -f -y "${data_img}"
+# Check the populated filesystem before making the disk image.
+if e2fsck -f -y "${data_img}"; then
+    :
+else
+    fsck_status=$?
+    # e2fsck returns 1 when it corrected the filesystem. Other nonzero
+    # statuses (including "reboot required") must still fail the build.
+    if [ "${fsck_status}" -ne 1 ]; then
+        exit "${fsck_status}"
+    fi
+fi
+
+# On Cube2v0, resize2fs -M has left the journal inode pointing past the new
+# filesystem end. Keep the original 1280M filesystem; it fits on the 8GB eMMC
+# and will be expanded with the data partition on first boot.
+if [ "${board}" = "Cube2v0" ]; then
+    exit 0
+fi
+
+# Shrink the filesystem to its minimum size on other boards.
 resize2fs -M "${data_img}"
 
 # Truncate image file to match the filesystem size
diff --git i/buildroot-external/package/hassio/hassio.mk w/buildroot-external/package/hassio/hassio.mk
index 4f73167..12ef761 100644
--- i/buildroot-external/package/hassio/hassio.mk
+++ w/buildroot-external/package/hassio/hassio.mk
@@ -37,7 +37,7 @@ endef
 HASSIO_INSTALL_IMAGES = YES
 
 define HASSIO_INSTALL_IMAGES_CMDS
-	$(BR2_EXTERNAL_HAOS_PATH)/package/hassio/create-data-partition.sh "$(@D)" "$(BINARIES_DIR)" "$(HASSIO_VERSION_CHANNEL)" "$(DOCKER_ENGINE_VERSION)"
+	$(BR2_EXTERNAL_HAOS_PATH)/package/hassio/create-data-partition.sh "$(@D)" "$(BINARIES_DIR)" "$(HASSIO_VERSION_CHANNEL)" "$(DOCKER_ENGINE_VERSION)" "$(BR2_PACKAGE_OS_AGENT_BOARD)"
 endef
 
 $(eval $(generic-package))
